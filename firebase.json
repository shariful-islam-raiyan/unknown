{
  "hosting": {
    // আপনার index.html, config.js ইত্যাদি যেই ফোল্ডারে আছে। রুটে থাকলে "."
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    // এক‑পেজ‑অ্যাপের জন্য (রাউটিং‑এ "index.html" রি‑ডাইরেক্ট)
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}